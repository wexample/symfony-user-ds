{
  "name": "wexample/symfony-user-ds",
  "description": "Design-system screens for symfony-user: login, second factor, password, terms, authenticator app",
  "version": "4.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyUserDs\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-user": ">=11.0.0",
    "wexample/symfony-design-system": ">=32.0.0",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-loader": ">=22.0.0",
    "wexample/symfony-forms": ">=11.0.0",
    "wexample/symfony-tunnels": ">=10.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  },
  "suggest": {
    "wexample/symfony-activity-ds": "Shows the history of each account on its administration page"
  }
}