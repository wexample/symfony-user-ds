{#- The members of one group, their access, and for its administrators the
    way to change them: a new one is added above the list, each member
    opens in a modal. Drawn by `memberships(group)` in whichever page hosts
    it — the package's, or the application's in its own layout —, which
    names the group. The table stands in the page, never in a block. -#}
<div class="memberships stack--vertical">
    {%- if membership_add_form -%}
    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/user-plus') }}</span>
            <span class="block--title-label">{{ '@component::add.title' | trans }}</span>
        </div>
        <div class="block--body">
            {{ form_load(render_pass, membership_add_form, '@WexampleSymfonyUserDsBundle/forms/membership_add_form.html.twig') }}
        </div>
    </section>
    {%- endif -%}

    {%- if rows -%}
        {%- set table_rows = [] -%}
        {%- for row in rows -%}
            {%- set grants_cell -%}
                {%- for grant in row.grants -%}{{ marker('neutral', grant | capitalize, { compact: true }) }} {% endfor -%}
            {%- endset -%}
            {#- Its leaving asked first, then its access changed in a modal. -#}
            {%- set table_rows = table_rows | merge([{
                member: row.label,
                grants: grants_cell,
                actions: administers ? [
                    {
                        href: row.remove_url,
                        method: 'post',
                        token: csrf_token('submit'),
                        icon: 'ph:bold/user-minus',
                        label: '@component::action.remove' | trans,
                        confirm: { title: '@component::action.remove' | trans, message: '@component::remove.confirm' | trans, accept: '@component::action.remove' | trans },
                    },
                    { href: row.url, target: 'modal', icon: 'ph:bold/pencil-simple', label: '@component::action.edit' | trans },
                ] : [],
            }]) -%}
        {%- endfor -%}

        {%- set columns = [
            { key: 'member', label: '@component::column.member' | trans },
            { key: 'grants', label: '@component::column.grants' | trans, cell: 'html' },
        ] -%}
        {%- if administers -%}
            {%- set columns = columns | merge([{ key: 'actions', label: '', cell: 'actions', class: 'table--cell--nowrap' }]) -%}
        {%- endif -%}

        {{ data_table(columns, table_rows) }}
    {%- else -%}
        <p>{{ '@component::empty' | trans }}</p>
    {%- endif -%}

</div>
