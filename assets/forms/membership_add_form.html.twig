{%- extends '@WexampleSymfonyLoaderBundle/bases/form.html.twig' -%}

{#- Who joins, then one switch per grant the application declared. -#}
{% block form_body %}
    {{ form_row(form.member) }}
    {% for child in form %}
        {% if child.vars.name starts with 'grant_' %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
    {{ form_actions(form) }}
{% endblock %}
