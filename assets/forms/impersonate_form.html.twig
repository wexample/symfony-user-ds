{%- extends '@WexampleSymfonyLoaderBundle/bases/form.html.twig' -%}

{% block form_body %}
    {{ form_row(form.account) }}
    <div class="form--actions">
        {{ form_widget(form.submit) }}
        {%- if form.vars.exit_url -%}
            <a class="button button--flat" href="{{ form.vars.exit_url }}">{{ '@form::action.exit' | trans }}</a>
        {%- endif -%}
    </div>
{% endblock %}
