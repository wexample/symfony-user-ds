{%- extends '@WexampleSymfonyUserDsBundle/tunnels/totp_setup/_step.html.twig' -%}

{%- block step_body -%}
    {%- if required -%}
        {{ message_info('@page::required') }}
    {%- endif -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>
    <div class="media media--square totp-setup--qr"><img src="{{ qr_code }}" alt="{{ '@page::qr_alt' | trans }}" width="240" height="240"></div>
    {#- The key is the code's own alternative, right under it. -#}
    {{ fallback('@page::secret', secret, { center: true }) }}
{%- endblock -%}

{#- In development, the app not set up at all: the session goes on without
    it, said apart and loud. -#}
{%- block step_after -%}
    {%- if skip_url -%}
        {{ message_dev('@page::dev_skip.title', '@page::dev_skip.body', {
            action: { icon: 'ph:bold/fast-forward', label: '@page::dev_skip.action', href: skip_url },
        }) }}
    {%- endif -%}
{%- endblock -%}
