{#- The account's own menu, opened from its initials: who is signed in at its
    head — and, when the application says it, as what (`role_labels`, one line
    each; `role_label` for a single one) —, the application's
    own entries (`items`), the authenticator app, the language, what only
    development has (switching account, the mailbox, and the application's own
    `development_items`, given only where they exist), the application's closing entries
    (`items_end`: terms, policies), and leaving.
    Drawn by the design system's button_menu. -#}
{%- set user = app.user -%}
{%- set language_items = locale_menu_items() -%}
{%- set roles = role_labels|default(role_label|default(null) ? [role_label] : []) -%}
{%- set entries = [{ heading: user.displayName, lines: roles }]
    |merge(items|default([]))
    |merge([{ icon: 'ph:bold/shield-check', label: 'WexampleSymfonyUserDsBundle.common.menu::authenticator' | trans, href: path('user_totp_index') }]) -%}
{%- if language_items|length > 1 -%}
    {%- set entries = entries
        |merge([{ separator: true, label: 'WexampleSymfonyUserDsBundle.common.menu::language' | trans }])
        |merge(language_items) -%}
{%- endif -%}
{#- What only development has, where the same sign says it is development:
    the mail of symfony-mail's mailbox, routed in dev and test alone, opened
    beside the page, which stays where it is; and the switch to another
    account, where the firewall allows impersonation. -#}
{%- set mailbox = mailbox_url() -%}
{%- set impersonation = impersonation_url() -%}
{%- set development = (development_items|default([]))|map(item => item|merge({ tone: 'dev' })) -%}
{%- if impersonation -%}
    {%- set development = development|merge([{ icon: 'ph:bold/user-switch', label: 'WexampleSymfonyUserDsBundle.common.menu::impersonate' | trans, href: impersonation, target: 'modal', tone: 'dev' }]) -%}
{%- endif -%}
{%- if mailbox -%}
    {%- set development = development|merge([{ icon: 'ph:bold/envelope-simple', label: 'WexampleSymfonyUserDsBundle.common.menu::mailbox' | trans, href: mailbox, new_window: true, tone: 'dev' }]) -%}
{%- endif -%}
{%- if development is not empty -%}
    {%- set entries = entries
        |merge([{ separator: true, label: 'WexampleSymfonyUserDsBundle.common.menu::development' | trans, tone: 'dev' }])
        |merge(development) -%}
{%- endif -%}
{%- if items_end|default([]) is not empty -%}
    {%- set entries = entries|merge([{ separator: true }])|merge(items_end) -%}
{%- endif -%}
{%- set entries = entries|merge([
    { separator: true },
    { icon: 'ph:bold/sign-out', label: 'WexampleSymfonyUserDsBundle.common.menu::logout' | trans, href: path('user_security_logout') },
]) -%}
{{ button_menu(null, null, entries, {
    class: 'button--flat',
    avatar: user.initials,
    menu_align: 'right',
    attr: { 'aria-label': 'WexampleSymfonyUserDsBundle.common.menu::label' | trans, title: user.displayName },
}) }}
