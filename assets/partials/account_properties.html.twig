{#- What an account is, as a page shows it — its holder's profile, or its
    page in the administration: `account` as
    AccountDirectoryService::describeAccount() gives it. Its state only with
    `with_state`: an administrator's concern, not its holder's. -#}
{%- set account_domain = 'WexampleSymfonyUserDsBundle.common.account::' -%}
{%- set with_state = with_state|default(false) -%}
{%- set state -%}
    {%- if account.locked -%}
        {{ marker('danger', (account_domain ~ 'state.locked') | trans, { compact: true }) }}
    {%- elseif not account.enabled -%}
        {{ marker('warning', (account_domain ~ 'state.disabled') | trans, { compact: true }) }}
    {%- elseif not account.activated -%}
        {{ marker('info', (account_domain ~ 'state.waiting') | trans, { compact: true }) }}
    {%- else -%}
        {{ marker('success', (account_domain ~ 'state.active') | trans, { compact: true }) }}
    {%- endif -%}
    {%- if account.password_change_required -%}
        {{ marker('warning', (account_domain ~ 'state.password_owed') | trans, { compact: true }) }}
    {%- endif -%}
{%- endset -%}
{%- set roles -%}
    {%- include '@WexampleSymfonyUserDsBundle/partials/roles.html.twig' with { roles: account.roles } -%}
{%- endset -%}
<section class="block block--padded">
    {{ properties([
        { key: (account_domain ~ 'field.email') | trans, value: account.email },
        { key: (account_domain ~ 'field.username') | trans, value: account.username ?: '—' },
        { key: (account_domain ~ 'field.initials') | trans, value: account.initials ?: '—' },
        with_state ? { key: (account_domain ~ 'field.state') | trans, value: state, html: true },
        { key: (account_domain ~ 'field.roles') | trans, value: roles, html: true },
        { key: (account_domain ~ 'field.date_last_login') | trans, value: account.date_last_login ? date_display(account.date_last_login, 'date_time_short') : '—', html: true },
    ] | filter(property => property), { columns: true }) }}
</section>
