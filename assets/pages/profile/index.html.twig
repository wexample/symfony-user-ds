{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- One card per thing the holder can do about its own account: read what it
    is, rename itself, reach its authenticator, forget its trusted devices,
    change its password, read the terms it accepted. The
    email is read and not changed: it is the identifier it signs in with. -#}
{%- block page_body -%}
    {%- include '@WexampleSymfonyUserDsBundle/partials/account_properties.html.twig' -%}

    {%- if profile_form -%}
    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/user') }}</span>
            <span class="block--title-label">{{ '@page::profile.title' | trans }}</span>
        </div>
        <div class="block--body">
            {{ form_load(render_pass, profile_form, '@WexampleSymfonyUserDsBundle/forms/profile_form.html.twig') }}
        </div>
    </section>
    {%- endif -%}

    {#- The groups the account belongs to, where the application has any. -#}
    {%- set memberships = user_memberships() -%}
    {#- A table stands on the page, never in a block. -#}
    {%- if memberships -%}
    <section class="stack--vertical">
        <h2>{{ '@page::memberships.title' | trans }}</h2>
        {%- set membership_rows = [] -%}
        {%- for membership in memberships -%}
            {%- set group_cell -%}
                {%- if membership.url -%}
                    <a class="text-link" href="{{ membership.url }}">{{ membership.label }}</a>
                {%- else -%}
                    {{ membership.label }}
                {%- endif -%}
            {%- endset -%}
            {%- set grants_cell -%}
                {%- for grant in membership.grants -%}{{ marker('neutral', grant | capitalize, { compact: true }) }} {% endfor -%}
            {%- endset -%}
            {%- set membership_rows = membership_rows | merge([{ name: group_cell, grants: grants_cell }]) -%}
        {%- endfor -%}
        {{ data_table([
            { key: 'name', label: '@page::memberships.group' | trans, cell: 'html' },
            { key: 'grants', label: '@page::memberships.grants' | trans, cell: 'html' },
        ], membership_rows) }}
    </section>
    {%- endif -%}

    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/shield-check') }}</span>
            <span class="block--title-label">{{ '@page::security.title' | trans }}</span>
        </div>
        <div class="block--body">
            <p class="text-secondary">{{ '@page::security.intro' | trans }}</p>
        </div>
        <div class="block--footer block--footer--end">
            {{ button_link('ph:bold/device-mobile', '@page::security.open' | trans, path('user_totp_index')) }}
        </div>
    </section>

    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/devices') }}</span>
            <span class="block--title-label">{{ '@page::devices.title' | trans }}</span>
        </div>
        <div class="block--body">
            <p class="text-secondary">{{ '@page::devices.intro' | trans }}</p>
        </div>
        <div class="block--footer block--footer--end">
            <form method="post" action="{{ path('user_profile_revoke_devices') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('profile-revoke-devices') }}">
                {{ button('ph:bold/prohibit', '@page::devices.revoke' | trans, { type: 'submit' }) }}
            </form>
        </div>
    </section>

    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/password') }}</span>
            <span class="block--title-label">{{ '@page::password.title' | trans }}</span>
        </div>
        <div class="block--body">
            {{ form_load(render_pass, change_password_form, '@WexampleSymfonyUserDsBundle/forms/change_password_form.html.twig') }}
        </div>
    </section>

    {%- if terms_history -%}
    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/file-text') }}</span>
            <span class="block--title-label">{{ '@page::terms.title' | trans }}</span>
        </div>
        <div class="block--body">
            {{ properties(terms_history | map(acceptance => {
                key: acceptance.version,
                value: date_display(acceptance.acceptedAt, 'date_time_short'),
                html: true,
            })) }}
        </div>
    </section>
    {%- endif -%}
{%- endblock -%}
