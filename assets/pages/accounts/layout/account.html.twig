{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- One account, whichever of its views a page is: the header saying what
    kind of thing it is, the page named after the account; its tabs under the
    header — the way back to the list at their start, the
    account itself, then its history where symfony-activity keeps one
    (`has_activity`) —, and what can be done to it at the far end, on every
    tab. A page built on it gives `account`, `actions` and `csrf_token_id`,
    as AccountsController::renderAccountPage() does.

    Edit opens in a modal; every other action posts — deactivating, locking
    and sending a mail once confirmed — to the action endpoint of
    symfony-user with the token of the page — a click here, not a click
    somewhere else — and comes back to the account's page. -#}
{%- set page_show_title = true -%}
{%- set header_title = 'WexampleSymfonyUserDsBundle.pages.accounts.show::page_title' | trans -%}
{%- set page_title = account.name -%}

{%- set account_domain = 'WexampleSymfonyUserDsBundle.pages.accounts.layout.account::' -%}
{%- set action_icons = {
    'deactivate': 'ph:bold/user-minus',
    'reactivate': 'ph:bold/user-check',
    'lock': 'ph:bold/lock',
    'unlock': 'ph:bold/lock-open',
    'password-mail': 'ph:bold/envelope-simple',
} -%}
{#- What cuts the holder off or reaches them is asked first. -#}
{%- set confirmed_actions = ['deactivate', 'lock', 'password-mail'] -%}

{%- block page_navigation -%}
    {{ page_tabs([
        { label: (account_domain ~ 'tab.general') | trans, route: 'user_accounts_show', params: { id: account.id }, icon: 'ph:bold/user' },
        has_activity ? { label: (account_domain ~ 'tab.activity') | trans, route: 'user_accounts_activity', params: { id: account.id }, icon: 'ph:bold/clock-counter-clockwise' },
    ] | filter(tab => tab), {
        back: true,
        actions: [{
            icon: 'ph:bold/pencil-simple',
            label: (account_domain ~ 'action.edit') | trans,
            href: path('user_accounts_edit', { id: account.id }),
            target: 'modal',
        }] | merge(actions | map(action => {
            icon: action_icons[action.value],
            label: (account_domain ~ 'action.' ~ action.value ~ (action.value == 'password-mail' and not account.activated ? '_activation' : '')) | trans,
            href: path('user_accounts_action', { id: account.id, action: action.value }),
            method: 'post',
            token: csrf_token(csrf_token_id),
            confirm: action.value in confirmed_actions ? {
                title: (account_domain ~ 'action.' ~ action.value ~ (action.value == 'password-mail' and not account.activated ? '_activation' : '')) | trans,
                message: (account_domain ~ 'confirm.' ~ action.value ~ (action.value == 'password-mail' and not account.activated ? '_activation' : '')) | trans({ '%name%': account.name }),
                accept: (account_domain ~ 'confirm.accept') | trans,
            } : null,
        })),
    }) }}
{%- endblock -%}
