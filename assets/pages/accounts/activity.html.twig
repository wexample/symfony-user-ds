{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- The whole history of one account, newest first, narrowed to a category
    when one is chosen. The table and its pages are symfony-activity-ds's. -#}
{%- block page_body -%}
    <section class="block block--card">
        <div class="block--body stack--vertical">
            <p class="lead">{{ account.label }}</p>

            {%- if categories | length > 1 -%}
                <nav class="cluster" aria-label="{{ '@page::filter.label' | trans }}">
                    {{ button_link('ph:bold/list', '@page::filter.all' | trans, path('user_accounts_activity', { id: account.id }), { class: category ? 'button--flat' : 'button--invert' }) }}
                    {%- for name in categories -%}
                        {{ button_link('ph:bold/tag', name, path('user_accounts_activity', { id: account.id, category: name }), { class: name == category ? 'button--invert' : 'button--flat' }) }}
                    {%- endfor -%}
                </nav>
            {%- endif -%}

            {%- include '@WexampleSymfonyActivityDsBundle/partials/table.html.twig' -%}
        </div>
    </section>

    <div class="cluster">
        {{ button_link('ph:bold/arrow-left', '@page::back' | trans, path('user_accounts_show', { id: account.id }), { class: 'button--flat' }) }}
    </div>
{%- endblock -%}
