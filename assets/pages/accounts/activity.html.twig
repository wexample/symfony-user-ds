{%- extends '@WexampleSymfonyUserDsBundle/pages/accounts/layout/account.html.twig' -%}

{#- The whole history of one account, newest first, narrowed to a category
    when one is chosen. The table and its pages are symfony-activity-ds's; a
    table stands on the page, never in a block. -#}
{%- block page_body -%}
    <div class="stack--vertical">
        {%- if categories | length > 1 -%}
            <nav class="cluster" aria-label="{{ '@page::filter.label' | trans }}">
                {{ button_link('ph:bold/list', '@page::filter.all' | trans, path('user_accounts_activity', { id: account.id }), { class: category ? 'button--flat' : 'button--invert' }) }}
                {%- for name in categories -%}
                    {{ button_link('ph:bold/tag', name, path('user_accounts_activity', { id: account.id, category: name }), { class: name == category ? 'button--invert' : 'button--flat' }) }}
                {%- endfor -%}
            </nav>
        {%- endif -%}

        {#- Its details are as long as what was recorded: the table scrolls
            sideways rather than stretching the page. -#}
        {%- include '@WexampleSymfonyActivityDsBundle/partials/table.html.twig' with { scroll: true } -%}
    </div>
{%- endblock -%}
