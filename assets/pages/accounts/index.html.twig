{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- Creating one is a page of its own, opened in a modal; so is signing in as
    one of them, for an account allowed to (`impersonation_url()`). -#}
{%- block page_toolbar_right -%}
    {%- if impersonation_url() -%}
        {{ button_target('ph:bold/user-switch', 'WexampleSymfonyUserDsBundle.common.menu::impersonate' | trans, impersonation_url(), 'modal') }}
    {%- endif -%}
    {{ button_target('ph:bold/user-plus', '@page::action.create' | trans, path('user_accounts_create'), 'modal') }}
{%- endblock -%}

{#- The accounts, read from the api: searched, sorted and paged by the table.
    A table stands on the page, never in a block. -#}
{%- block page_body -%}
    {{ vue(render_pass, '@WexampleSymfonyUserDsBundle/components/account-table') }}
{%- endblock -%}
