{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- The members of one group, their access, and for its administrators the
    way to change them: each member opens in a modal, a new one is added
    below. -#}
{%- block page_body -%}
    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/users-three') }}</span>
            <span class="block--title-label">{{ group.membershipLabel }}</span>
        </div>
        <div class="block--body stack--vertical">
            {%- if rows -%}
                {%- set table_rows = [] -%}
                {%- for row in rows -%}
                    {%- set grants_cell -%}
                        {%- for grant in row.grants -%}{{ marker('neutral', grant | capitalize, { compact: true }) }} {% endfor -%}
                    {%- endset -%}
                    {%- set actions_cell -%}
                        {%- if administers -%}
                            {{ button_target('ph:bold/pencil-simple', '@page::action.edit' | trans, row.url, 'modal', { class: 'button--flat' }) }}
                        {%- endif -%}
                    {%- endset -%}
                    {%- set table_rows = table_rows | merge([{
                        member: row.label,
                        grants: grants_cell,
                        actions: actions_cell,
                    }]) -%}
                {%- endfor -%}

                {%- set columns = [
                    { key: 'member', label: '@page::column.member' | trans },
                    { key: 'grants', label: '@page::column.grants' | trans, cell: 'html' },
                ] -%}
                {%- if administers -%}
                    {%- set columns = columns | merge([{ key: 'actions', label: '', cell: 'html', class: 'table--cell--nowrap' }]) -%}
                {%- endif -%}

                {{ data_table(columns, table_rows) }}
            {%- else -%}
                <p>{{ '@page::empty' | trans }}</p>
            {%- endif -%}
        </div>
    </section>

    {%- if membership_add_form -%}
    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/user-plus') }}</span>
            <span class="block--title-label">{{ '@page::add.title' | trans }}</span>
        </div>
        <div class="block--body">
            {{ form_load(render_pass, membership_add_form, '@WexampleSymfonyUserDsBundle/forms/membership_add_form.html.twig') }}
        </div>
    </section>
    {%- endif -%}
{%- endblock -%}
