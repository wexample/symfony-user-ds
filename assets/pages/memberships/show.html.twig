{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- One member of a group: its access, changed, reloads the page listing
    the members. Its leaving is on its row there. -#}
{%- block page_body -%}
    <section class="block block--padded">
        {{ properties([
            { key: '@page::field.member' | trans, value: member_label },
            { key: '@page::field.group' | trans, value: group.membershipLabel },
        ], { columns: true }) }}
    </section>

    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/key') }}</span>
            <span class="block--title-label">{{ '@page::grants.title' | trans }}</span>
        </div>
        <div class="block--body">
            {{ form_load(render_pass, membership_grants_form, '@WexampleSymfonyUserDsBundle/forms/membership_grants_form.html.twig') }}
        </div>
    </section>
{%- endblock -%}
