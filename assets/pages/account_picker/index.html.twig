{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- One thing to do and nothing around it: the layout's focus. -#}
{%- set page_focus = true -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    <section class="block block--card">
        <div class="block--body stack--vertical">
            {#- Many accounts: a search first, its results in the select. -#}
            {%- if searching -%}
                <form method="get" class="cluster">
                    <input type="search" name="q" value="{{ query }}" minlength="{{ search_min_length }}" required
                           aria-label="{{ '@page::search.label' | trans }}" placeholder="{{ '@page::search.label' | trans }}">
                    <button type="submit" class="button">{{ '@page::search.submit' | trans }}</button>
                </form>
            {%- endif -%}
            {%- if account_picker_form -%}
                {{ form_load(render_pass, account_picker_form, '@WexampleSymfonyUserDsBundle/forms/account_picker_form.html.twig') }}
            {%- elseif not searching or query -%}
                <p>{{ '@page::empty' | trans }}</p>
            {%- endif -%}
        </div>
    </section>
{%- endblock -%}
