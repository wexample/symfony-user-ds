{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- One thing to do and nothing around it: the layout's focus. -#}
{%- set page_focus = true -%}

{%- set page_show_title = true -%}

{#- Two ways in, one card each: the password, then the link sent by email.
    The fields in the first card, its actions in the card's foot: the way
    back when the password is forgotten at one end, signing in at the other. -#}
{%- block page_body -%}
    {#- Sent back here by a session left alone too long. -#}
    {%- if session_expired -%}
        {{ message_warning('@page::session_expired' | trans) }}
    {%- endif -%}
    {#- Come from a page kept for signed-in visitors: reached once signed in. -#}
    {%- if session_required -%}
        {{ message_info('@page::session_required' | trans) }}
    {%- endif -%}

    <section class="block block--card">
        <div class="block--body">
            {{ form_load(render_pass, login_form, '@WexampleSymfonyUserDsBundle/forms/login_form.html.twig', { actions: false }) }}
        </div>
        <div class="block--footer">
            {{ form_actions(login_form, {
                outside: true,
                secondary: [{ icon: 'ph:bold/key', label: '@page::forgot_password' | trans, href: path('user_password_forgot') }],
            }) }}
        </div>
    </section>

    {%- if magic_link_request_form -%}
    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/envelope-simple') }}</span>
            <span class="block--title-label">{{ '@page::magic_link' | trans }}</span>
        </div>
        <div class="block--body">
            {{ form_load(render_pass, magic_link_request_form, '@WexampleSymfonyUserDsBundle/forms/magic_link_request_form.html.twig') }}
        </div>
    </section>
    {%- endif -%}
{%- endblock -%}
